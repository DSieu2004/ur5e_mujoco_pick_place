<?xml version="1.0"?>
<launch>
  <let
    name="robot_description"
    value="$(command 'xacro $(find-pkg-share ur5e_mujoco_sim)/config/ur5e_pid.urdf')"/>
  <let
    name="robot_description_semantic"
    value="$(command 'cat $(find-pkg-share ur5e_mujoco_sim)/config/ur5e.srdf')"/>
  <let
    name="pid_controller_yaml"
    value="$(command 'python3 $(find-pkg-share ur5e_mujoco_sim)/pid_lib/write_profile.py $(find-pkg-share ur5e_mujoco_sim)/config/ros2_controllers.yaml')"/>

  <node pkg="mujoco_ros2_control" exec="ros2_control_node" output="screen" on_exit="shutdown">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="use_sim_time" value="true" type="bool"/>
    <param from="$(var pid_controller_yaml)"/>
    <param from="$(find-pkg-share ur5e_mujoco_sim)/config/mujoco_plugins.yaml"/>
  </node>

  <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="use_sim_time" value="true" type="bool"/>
  </node>

  <node pkg="ur5e_mujoco_sim" exec="ur5e_move_group" name="move_group" output="screen">
    <param name="robot_description" value="$(var robot_description)" type="str"/>
    <param name="robot_description_semantic" value="$(var robot_description_semantic)" type="str"/>
    <param name="use_sim_time" value="true" type="bool"/>
    <param from="$(find-pkg-share ur5e_mujoco_sim)/config/move_group.yaml"/>
  </node>

  <!-- Spawn the effort controller promptly so the arm is not left without
       active feedback while MuJoCo gravity acts on it. -->
  <timer period="0.1">
    <node
      pkg="controller_manager"
      exec="spawner"
      args="joint_state_broadcaster ur5e_controller gripper_controller --controller-manager /controller_manager --param-file $(var pid_controller_yaml)"
      output="screen"/>
  </timer>
</launch>
